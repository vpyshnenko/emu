#mod_use "layout.ml";;
#use "../../tools/explorer/explorer.ml";;
module Explorer = Make(Emu.Step)(Layout);;

(* Define a simple, non-blocking shortcut *)
let explore nodeA nodeB value ?node () =
  let digest = Ping_pong.Sim.run nodeA nodeB value in
  Explorer.explore ?node digest
;;
let send nodeA nodeB value =
  let digest = Ping_pong.Sim.run nodeA nodeB value in
  Digest.print_out_stream ~label:"dest node out stream" nodeB digest
;;
print_endline "\n=== EMU Explorer REPL READY ===";
print_endline "Type: send 0 4 42      (runs simulation for sending 42 from Node0 to Node4)";
print_endline "Type: explore 0 4 42 ()      (to explore the entire history of simulation for Node0 ping Node4)";
print_endline "Type: explore 0 4 42 2 ()      (to explore history of steps only for Node2)"

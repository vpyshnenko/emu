#require "emu";;
#mod_use "utils.ml";;
#mod_use "layout.ml";;
#mod_use "handlers.ml";;
#mod_use "netbuilder.ml";;
#use "explorer.ml";;        
module Explorer = Make(Emu.Step);;

#use "sim.ml";;  

(* Define a simple, non-blocking shortcut *)
let go ?(root=0) ?node () =
  let digest = run root in
  Explorer.explore ?node digest
;;
print_endline "\n=== EMU REPL READY ===";
print_endline "Type: go ()       (runs simulation with Root 0)";
print_endline "Type: go ~root:3 ~node:3 () (runs simulation with Root 3 and filters only Node 3 steps)\n";;